# HTTPS in front of the console, with a certificate from Let's Encrypt that
# Caddy obtains and renews by itself. Enabled by ./ctl.sh https <domain> <email>.
{
	email {$ACME_EMAIL}
	admin off
}

{$KIVULI_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# The server shell (./ctl.sh shell on). Every request, the WebSocket included,
	# is first put to Kivuli: an administrator with two-step sign-in who opened the
	# shell in the console gets through to the SSH login; anyone else gets 403.
	handle /shell* {
		forward_auth web:3000 {
			uri /api/shell/authorize
		}
		reverse_proxy shell:3000
	}
	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto https
		}
	}
	log {
		output stdout
		format console
	}
}
