# ─────────────────────────────────────────────────────────────────────────────
#  Kivuli - dark-web security-research workstation
#
#  ./ctl.sh start copies this file to .env on first run and fills in every
#  secret with a generated value. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Console ──────────────────────────────────────────────────────────────────
APP_NAME=Kivuli
WEB_PORT=3000
# Address the console listens on. 127.0.0.1 = this machine only (reach it through
# an SSH tunnel or a reverse proxy). 0.0.0.0 = every network interface: anyone who
# can reach the machine can reach the sign-in page, over plain HTTP.
WEB_BIND=127.0.0.1
# Address analysts use to reach the console; alert emails link to it.
PUBLIC_URL=http://localhost:3000
# Set to true when the console is served over HTTPS.
COOKIE_SECURE=false

# First administrator, created once when the user table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@kivuli.local
BOOTSTRAP_ADMIN_PASSWORD=

# ── Secrets (generated) ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# Signs the evidence chain. Back it up: without it stored evidence cannot be verified.
EVIDENCE_HMAC_KEY=
# Encrypts integration credentials and MFA seeds in the database. Back it up too.
SECRETS_KEY=
# Encrypts provider API keys entered in the console. Only the API and the enricher hold it.
PROVIDER_KEYS_KEY=

# ── Collection policy ────────────────────────────────────────────────────────
# ISO country codes you care most about. Findings about them score higher and
# get a dedicated ransomware-victim feed.
FOCUS_COUNTRIES=KE
# Industries you care most about, as trackers name them (comma separated).
FOCUS_SECTORS=

# Mask passwords, keys and card numbers before anything is stored or emailed.
REDACT_SECRETS=true
# Also keep the unredacted capture on the evidence volume (gzip, by SHA-256).
# Off by default: turning it on makes this system a store of stolen credentials.
EVIDENCE_STORE_RAW=false

# Record onion sites linked from crawled pages as discovered sources. Whether they
# are then collected is the collection policy, set in the console.
DISCOVER_ONION_LINKS=true
MAX_CANDIDATES_PER_CRAWL=25
# How often candidate and paused sources are re-checked for liveness.
LIVENESS_INTERVAL_HOURS=12

# Crawler limits.
CRAWL_MAX_BYTES=2000000
CRAWL_TIMEOUT_SECONDS=75
CRAWL_HOST_DELAY_SECONDS=3

# Clearnet hosts the crawler may reach directly (HTTPS only). Everything else,
# and every .onion site, goes through Tor. A leading dot allows subdomains.
# Changing this list requires restarting the egress container.
EGRESS_ALLOW_HOSTS=api.ransomware.live,www.ransomlook.io,www.cisa.gov,www.bleepingcomputer.com,feeds.feedburner.com,databreaches.net,securityaffairs.com,therecord.media,krebsonsecurity.com,hackread.com,feodotracker.abuse.ch,raw.githubusercontent.com,t.me,internetdb.shodan.io,stat.ripe.net,dns.google,api.certspotter.com,crt.sh,api.first.org,services.nvd.nist.gov,www.virustotal.com,api.shodan.io,api.abuseipdb.com,api.greynoise.io,api.anthropic.com,ahmia.fi

# ── Email alerts ─────────────────────────────────────────────────────────────
EMAIL_ENABLED=true
# Default recipients for watchlists that do not name their own (comma separated).
ALERT_EMAIL_TO=soc@kivuli.local
SMTP_FROM=Kivuli Alerts <alerts@kivuli.local>
# Out of the box mail goes to the bundled Mailpit inbox (http://localhost:8025),
# so alerting can be tried without a mail account. For real delivery point these
# at your relay, for example:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_TLS=starttls
#   SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<app password>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
# Hour (UTC) at which watchlists set to "digest" are mailed.
DIGEST_HOUR_UTC=6
MAILPIT_PORT=8025

# ── Access ───────────────────────────────────────────────────────────────────
# Flag admins who have not enrolled an authenticator app.
REQUIRE_MFA=false

# ── Attack surface (passive) ─────────────────────────────────────────────────
# Runs only for watchlist entries marked as assets you own. Uses certificate
# transparency, public DNS and Shodan InternetDB: nothing is scanned.
ASM_MAX_HOSTS=300
ASM_INTERVAL_DAYS=7

# ── Integrations ─────────────────────────────────────────────────────────────
# Allow webhooks, Splunk, Jira and ServiceNow destinations on private addresses
# (an internal SIEM). Off by default so the console cannot be used to reach
# internal services by mistake.
INTEGRATIONS_ALLOW_PRIVATE=false

# ── Enrichment providers (optional, commercial) ──────────────────────────────
# Easiest: leave these empty and enter keys in the console (Integrations >
# Enrichment and AI), where each key is tested against its provider as you save
# it. A key entered in the console takes precedence over one set here.
# Lookups ask the provider about an indicator; the indicator itself is never
# contacted. Free providers (Shodan InternetDB, RIPEstat, public DNS,
# certificate transparency, EPSS, NVD) need no key.
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
# Optional: raises the NVD rate limit for CVSS lookups.
NVD_API_KEY=

# ── AI analyst (optional) ────────────────────────────────────────────────────
# With a key, analysts can ask questions answered from collected findings with
# citations, translate plain language into queries, and draft summaries. The
# model sees only retrieved, already-redacted findings. Without a key nothing
# is sent anywhere and these features are switched off. The key and the model
# can also be set, and tested, in the console.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Resources ────────────────────────────────────────────────────────────────
SEARCH_HEAP=768m
CRAWLER_CONCURRENCY=6
PIPELINE_CONCURRENCY=4
